logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------
# Runtime & Cache
# -------------------------------------------------------
*.local
.cache/
.parcel-cache/
.vite/
*.pid
*.seed
*.pid.lock

# -------------------------------------------------------
